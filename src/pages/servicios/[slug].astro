---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getServiceBySlug, services } from '../../data/services';

export async function getStaticPaths() {
	return services.map((service) => ({
		params: { slug: service.slug },
		props: { service },
	}));
}

const { service } = Astro.props;

if (!service) {
	return Astro.redirect('/');
}

// Mapeo entre slugs de servicios y nombres de carpetas
const serviceFolderMap: Record<string, string> = {
	'carritos': 'carritos',
	'juegos-mecanicos': 'juegosmecanicos',
	'juegos-inflables': 'juegosinflables',
	'juegos-de-salon': 'juegosdesalon',
	'juegos-stand': 'shows', // Los stand están en shows
	'shows': 'produccion',
	'recuerdos-foto-video': 'recuerdosfotoyvideo'
};

// Máximo de imágenes a cargar: 1 portada + 8 en galería (solo las necesarias)
const MAX_SERVICE_IMAGES = 9;
const IMG_EXT = 'jpeg'; // una sola extensión para no duplicar peticiones

// Función para obtener solo las imágenes necesarias de un servicio (pocas, una extensión)
function getServiceImages(slug: string): string[] {
	const folderName = serviceFolderMap[slug] || slug;
	const images: string[] = [];
	const ext = IMG_EXT;

	if (slug === 'carritos') {
		for (let i = 1; i <= MAX_SERVICE_IMAGES; i++) {
			images.push(`/images/${folderName}/carritos${i}.${ext}`);
		}
	} else if (slug === 'juegos-mecanicos') {
		// toro (portada típica) + reloj, alternando pocos
		for (let i = 1; i <= 5; i++) images.push(`/images/${folderName}/toro${i}.jpg`);
		for (let i = 1; i <= 4; i++) images.push(`/images/${folderName}/reloj${i}.${ext}`);
	} else if (slug === 'juegos-inflables') {
		for (let i = 1; i <= MAX_SERVICE_IMAGES; i++) {
			images.push(`/images/${folderName}/inflable${i}.${ext}`);
		}
	} else if (slug === 'juegos-de-salon') {
		for (let i = 1; i <= 3; i++) images.push(`/images/${folderName}/arcade${i}.${ext}`);
		for (let i = 1; i <= 2; i++) images.push(`/images/${folderName}/hockey${i}.${ext}`);
		for (let i = 1; i <= 2; i++) images.push(`/images/${folderName}/tacataca${i}.${ext}`);
		for (let i = 1; i <= 2; i++) images.push(`/images/${folderName}/aro${i}.${ext}`);
	} else if (slug === 'juegos-stand') {
		for (let i = 1; i <= MAX_SERVICE_IMAGES; i++) {
			images.push(`/images/${folderName}/stand${i}.${ext}`);
		}
	} else if (slug === 'shows') {
		for (let i = 1; i <= MAX_SERVICE_IMAGES; i++) {
			images.push(`/images/${folderName}/produccion${i}.${ext}`);
		}
	} else if (slug === 'recuerdos-foto-video') {
		for (let i = 1; i <= 5; i++) images.push(`/images/${folderName}/totem${i}.${ext}`);
		for (let i = 1; i <= 4; i++) images.push(`/images/${folderName}/giro${i}.${ext}`);
	}

	return images.slice(0, MAX_SERVICE_IMAGES);
}

// Obtener todas las imágenes del servicio
const allImages = getServiceImages(service.slug);
// La primera imagen es la portada, el resto van a la galería
const coverImage = allImages[0] || null;
const galleryImages = allImages.slice(1);
---

<Layout title={`${service.title} - Artemagia`}>
	<Navbar />
	
	<section class="service-detail">
		<div class="service-detail-background"></div>
		<div class="container">
			<div class="service-detail-header">
				<a href="/#servicios" class="back-link">
					<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
						<path d="M12 4L6 10L12 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
					Volver a servicios
				</a>
				<div class="service-icon-large">{service.icon}</div>
				<h1 class="service-detail-title">{service.title}</h1>
				<p class="service-detail-subtitle">{service.shortDescription}</p>
			</div>

			<div class="service-detail-content">
				<div class="service-detail-main">
					<div class="service-section">
						<h2 class="section-heading">Descripción</h2>
						<p class="service-full-description">{service.fullDescription}</p>
					</div>

					<div class="service-section">
						<h2 class="section-heading">Características</h2>
						<ul class="features-list">
							{service.features.map((feature) => (
								<li class="feature-item">
									<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
										<path d="M16.667 5L7.5 14.167L3.333 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
									{feature}
								</li>
							))}
						</ul>
					</div>

					{service.includes && service.includes.length > 0 && (
						<div class="service-section">
							<h2 class="section-heading">Incluye</h2>
							<ul class="includes-list">
								{service.includes.map((item) => (
									<li class="include-item">
										<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
											<circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2"/>
											<path d="M7 10L9 12L13 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
										</svg>
										{item}
									</li>
								))}
							</ul>
						</div>
					)}

					{service.additionalInfo && (
						<div class="service-section">
							<h2 class="section-heading">Información adicional</h2>
							<p class="additional-info">{service.additionalInfo}</p>
						</div>
					)}

					{(coverImage || galleryImages.length > 0) && (
						<div class="service-section">
							<h2 class="section-heading">Galería de Imágenes</h2>
							
							{/* Imagen de portada */}
							{coverImage && (
								<div class="cover-image-container">
									<img 
										src={coverImage} 
										alt={`${service.title} - Portada`}
										class="cover-image"
										loading="eager"
										data-image-index="0"
										onerror="this.parentElement.style.display='none'"
									/>
								</div>
							)}

							{/* Galería de imágenes */}
							{galleryImages.length > 0 && (
								<div class="image-gallery" id="image-gallery">
									{galleryImages.map((imagePath, index) => (
										<div class="gallery-item" data-image-index={index + 1}>
											<img 
												src={imagePath} 
												alt={`${service.title} - Imagen ${index + 2}`}
												class="gallery-image"
												loading="lazy"
												onerror="this.parentElement.style.display='none'"
											/>
										</div>
									))}
								</div>
							)}
						</div>
					)}
				</div>

				<div class="service-detail-sidebar">
					<div class="contact-card">
						<h3>¿Interesado en este servicio?</h3>
						<p>Contáctanos para más información y obtener un presupuesto personalizado.</p>
						<a href="/#contacto" class="btn btn-primary btn-full">
							Solicitar presupuesto
						</a>
						<a href="mailto:contacto@artemagia.cl" class="contact-email">
							contacto@artemagia.cl
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<Footer />

	<!-- Modal para ver imágenes en tamaño completo -->
	{(coverImage || galleryImages.length > 0) && (
		<div class="image-modal" id="image-modal">
			<button class="modal-close" id="modal-close" aria-label="Cerrar">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
					<path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
				</svg>
			</button>
			<button class="modal-nav modal-prev" id="modal-prev" aria-label="Anterior">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
					<path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
			</button>
			<button class="modal-nav modal-next" id="modal-next" aria-label="Siguiente">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
					<path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
			</button>
			<div class="modal-content">
				<img id="modal-image" src="" alt="" class="modal-image-full" />
			</div>
		</div>
	)}
</Layout>

<script>
	// Funcionalidad del modal de imágenes
	const coverImage = document.querySelector('.cover-image');
	const gallery = document.getElementById('image-gallery');
	const modal = document.getElementById('image-modal');
	const modalImage = document.getElementById('modal-image') as HTMLImageElement | null;
	const modalClose = document.getElementById('modal-close');
	const modalPrev = document.getElementById('modal-prev');
	const modalNext = document.getElementById('modal-next');
	
	if (modal && modalImage && modalClose && modalPrev && modalNext) {
		let currentImageIndex = 0;
		let allImages: string[] = [];
		
		// Función para obtener todas las imágenes visibles
		function getAllVisibleImages(): string[] {
			const images: string[] = [];
			
			// Agregar imagen de portada si existe y es visible
			if (coverImage && (coverImage as HTMLImageElement).complete && (coverImage as HTMLImageElement).naturalWidth > 0) {
				const src = coverImage.getAttribute('src');
				if (src) images.push(src);
			}
			
			// Agregar imágenes de la galería que se cargaron correctamente
			if (gallery) {
				const galleryItems = gallery.querySelectorAll('.gallery-item:not([style*="display: none"]) img');
				galleryItems.forEach((element) => {
					const img = element as HTMLImageElement;
					if (img.complete && img.naturalWidth > 0) {
						const src = img.getAttribute('src');
						if (src) images.push(src);
					}
				});
			}
			
			return images;
		}
		
		// Actualizar lista de imágenes
		function updateImagesList() {
			allImages = getAllVisibleImages();
		}
		
		// Esperar a que las imágenes se carguen
		setTimeout(() => {
			updateImagesList();
			
			// Agregar event listeners a la imagen de portada
			if (coverImage) {
				coverImage.addEventListener('click', () => {
					currentImageIndex = 0;
					openModal();
				});
				(coverImage as HTMLImageElement).style.cursor = 'pointer';
			}
			
			// Agregar event listeners a las imágenes de la galería
			if (gallery) {
				const galleryItems = gallery.querySelectorAll('.gallery-item img');
				galleryItems.forEach((element) => {
					const img = element as HTMLImageElement;
					img.addEventListener('click', () => {
						// Encontrar el índice real en allImages
						const imgSrc = img.getAttribute('src');
						if (imgSrc) {
							currentImageIndex = allImages.indexOf(imgSrc);
							if (currentImageIndex === -1) currentImageIndex = 0;
							openModal();
						}
					});
					img.style.cursor = 'pointer';
				});
			}
		}, 500);
		
		// También actualizar cuando las imágenes se carguen
		if (coverImage) {
			coverImage.addEventListener('load', updateImagesList);
			coverImage.addEventListener('error', () => setTimeout(updateImagesList, 100));
		}
		
		if (gallery) {
			gallery.querySelectorAll('img').forEach(element => {
				const img = element as HTMLImageElement;
				img.addEventListener('load', updateImagesList);
				img.addEventListener('error', () => setTimeout(updateImagesList, 100));
			});
		}

		// Cerrar modal
		modalClose.addEventListener('click', closeModal);
		modal.addEventListener('click', (e) => {
			if (e.target === modal) {
				closeModal();
			}
		});

		// Navegación
		modalPrev.addEventListener('click', (e) => {
			e.stopPropagation();
			showPreviousImage();
		});

		modalNext.addEventListener('click', (e) => {
			e.stopPropagation();
			showNextImage();
		});

		// Navegación con teclado
		document.addEventListener('keydown', (e) => {
			if (modal && modal.classList.contains('active')) {
				if (e.key === 'Escape') {
					closeModal();
				} else if (e.key === 'ArrowLeft') {
					showPreviousImage();
				} else if (e.key === 'ArrowRight') {
					showNextImage();
				}
			}
		});

		function openModal() {
			if (modal && allImages.length > 0) {
				updateImagesList();
				modal.classList.add('active');
				document.body.style.overflow = 'hidden';
				updateModalImage();
			}
		}

		function closeModal() {
			if (modal) {
				modal.classList.remove('active');
				document.body.style.overflow = '';
			}
		}

		function updateModalImage() {
			if (allImages.length > 0 && currentImageIndex >= 0 && currentImageIndex < allImages.length) {
				if (modalImage) {
					modalImage.src = allImages[currentImageIndex];
					modalImage.alt = `Imagen ${currentImageIndex + 1}`;
				}
			}
		}

		function showPreviousImage() {
			if (allImages.length > 0) {
				currentImageIndex = (currentImageIndex - 1 + allImages.length) % allImages.length;
				updateModalImage();
			}
		}

		function showNextImage() {
			if (allImages.length > 0) {
				currentImageIndex = (currentImageIndex + 1) % allImages.length;
				updateModalImage();
			}
		}
	}
</script>

<style>
	.service-detail {
		min-height: 100vh;
		padding: 120px 0 4rem;
		background: var(--color-dark);
		position: relative;
		overflow: hidden;
	}

	.service-detail-background {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-dark-alt) 100%);
		z-index: -1;
	}

	.service-detail-background::before {
		content: '';
		position: absolute;
		top: -50%;
		right: -20%;
		width: 800px;
		height: 800px;
		background: radial-gradient(circle, rgba(147, 51, 234, 0.15) 0%, transparent 70%);
		border-radius: 50%;
		animation: float 20s ease-in-out infinite;
	}

	.service-detail-background::after {
		content: '';
		position: absolute;
		bottom: -30%;
		left: -10%;
		width: 600px;
		height: 600px;
		background: radial-gradient(circle, rgba(107, 70, 193, 0.15) 0%, transparent 70%);
		border-radius: 50%;
		animation: float 15s ease-in-out infinite reverse;
	}

	@keyframes float {
		0%, 100% { transform: translate(0, 0) scale(1); }
		50% { transform: translate(50px, 50px) scale(1.1); }
	}

	.service-detail-header {
		text-align: center;
		margin-bottom: 4rem;
		color: var(--color-text-white);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 600;
		margin-bottom: 2rem;
		transition: all 0.3s ease;
	}

	.back-link:hover {
		gap: 1rem;
		transform: translateX(-5px);
	}

	.service-icon-large {
		font-size: 5rem;
		margin-bottom: 1.5rem;
		animation: float-logo 6s ease-in-out infinite;
	}

	@keyframes float-logo {
		0%, 100% { transform: translateY(0) scale(1); }
		50% { transform: translateY(-10px) scale(1.05); }
	}

	.service-detail-title {
		font-size: 3.5rem;
		margin-bottom: 1rem;
		background: linear-gradient(135deg, var(--color-accent), #FFD700);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.service-detail-subtitle {
		font-size: 1.3rem;
		color: rgba(255, 255, 255, 0.8);
		max-width: 700px;
		margin: 0 auto;
	}

	.service-detail-content {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 3rem;
		position: relative;
		z-index: 1;
	}

	.service-detail-main {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.service-section {
		background: rgba(255, 255, 255, 0.05);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 20px;
		padding: 2.5rem;
	}

	.section-heading {
		font-size: 2rem;
		color: var(--color-accent);
		margin-bottom: 1.5rem;
	}

	.service-full-description {
		color: rgba(255, 255, 255, 0.9);
		font-size: 1.1rem;
		line-height: 1.8;
	}

	.features-list,
	.includes-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.feature-item,
	.include-item {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		color: rgba(255, 255, 255, 0.9);
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.feature-item svg,
	.include-item svg {
		flex-shrink: 0;
		margin-top: 0.2rem;
		color: var(--color-accent);
	}

	.additional-info {
		color: rgba(255, 255, 255, 0.9);
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.service-detail-sidebar {
		position: sticky;
		top: 120px;
		height: fit-content;
	}

	.contact-card {
		background: rgba(255, 255, 255, 0.05);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 20px;
		padding: 2.5rem;
		text-align: center;
	}

	.contact-card h3 {
		font-size: 1.5rem;
		color: var(--color-text-white);
		margin-bottom: 1rem;
	}

	.contact-card p {
		color: rgba(255, 255, 255, 0.8);
		margin-bottom: 2rem;
		line-height: 1.6;
	}

	.btn-full {
		width: 100%;
		margin-bottom: 1.5rem;
	}

	.contact-email {
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 600;
		transition: color 0.3s ease;
	}

	.contact-email:hover {
		color: #FFD700;
	}

	@media (max-width: 968px) {
		.service-detail-content {
			grid-template-columns: 1fr;
		}

		.service-detail-sidebar {
			position: static;
		}

		.service-detail-title {
			font-size: 2.5rem;
		}

		.service-icon-large {
			font-size: 4rem;
		}
	}

	@media (max-width: 640px) {
		.service-detail {
			padding: 100px 0 2rem;
		}

		.service-detail-title {
			font-size: 2rem;
		}

		.service-detail-subtitle {
			font-size: 1.1rem;
		}

		.service-section {
			padding: 1.5rem;
		}

	.section-heading {
		font-size: 1.5rem;
	}
}

/* Estilos para la galería de imágenes */
.cover-image-container {
	margin-top: 1.5rem;
	margin-bottom: 2rem;
	width: 100%;
	border-radius: 20px;
	overflow: hidden;
	background: rgba(255, 255, 255, 0.03);
	border: 2px solid rgba(255, 255, 255, 0.1);
	transition: all 0.3s ease;
	cursor: pointer;
}

.cover-image-container:hover {
	transform: translateY(-5px);
	border-color: var(--color-accent);
	box-shadow: 0 20px 50px rgba(212, 175, 55, 0.4);
}

.cover-image {
	width: 100%;
	height: auto;
	display: block;
	object-fit: cover;
	transition: transform 0.3s ease;
}

.cover-image-container:hover .cover-image {
	transform: scale(1.02);
}

.image-gallery {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
	gap: 1.5rem;
	margin-top: 1.5rem;
}

.gallery-item {
	position: relative;
	overflow: hidden;
	border-radius: 15px;
	aspect-ratio: 4/3;
	background: rgba(255, 255, 255, 0.03);
	border: 2px solid rgba(255, 255, 255, 0.1);
	transition: all 0.3s ease;
	cursor: pointer;
}

.gallery-item:hover {
	transform: translateY(-8px) scale(1.02);
	border-color: var(--color-accent);
	box-shadow: 0 15px 40px rgba(212, 175, 55, 0.3);
}

.gallery-image {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.3s ease;
}

.gallery-item:hover .gallery-image {
	transform: scale(1.05);
}

/* Modal para ver imágenes en tamaño completo */
.image-modal {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background: rgba(0, 0, 0, 0.95);
	backdrop-filter: blur(10px);
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 10000;
	opacity: 0;
	visibility: hidden;
	transition: all 0.3s ease;
}

.image-modal.active {
	opacity: 1;
	visibility: visible;
}

.modal-content {
	position: relative;
	max-width: 90vw;
	max-height: 90vh;
	display: flex;
	align-items: center;
	justify-content: center;
}

.modal-image-full {
	max-width: 100%;
	max-height: 90vh;
	object-fit: contain;
	border-radius: 10px;
	box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
}

.modal-close {
	position: absolute;
	top: 2rem;
	right: 2rem;
	background: rgba(255, 255, 255, 0.1);
	border: 2px solid rgba(255, 255, 255, 0.2);
	border-radius: 50%;
	width: 50px;
	height: 50px;
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	color: var(--color-text-white);
	transition: all 0.3s ease;
	z-index: 10001;
}

.modal-close:hover {
	background: rgba(255, 255, 255, 0.2);
	border-color: var(--color-accent);
	transform: rotate(90deg);
}

.modal-nav {
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
	background: rgba(255, 255, 255, 0.1);
	border: 2px solid rgba(255, 255, 255, 0.2);
	border-radius: 50%;
