---
import { services } from '../data/services';

const serviceFolderMap: Record<string, string> = {
	'carritos': 'carritos',
	'juegos-mecanicos': 'juegosmecanicos',
	'juegos-inflables': 'juegosinflables',
	'juegos-de-salon': 'juegosdesalon',
	'juegos-stand': 'shows',
	'shows': 'produccion',
	'recuerdos-foto-video': 'recuerdosfotoyvideo'
};

function getFirstServiceImage(slug: string): string | null {
	const folderName = serviceFolderMap[slug] || slug;
	if (slug === 'carritos') return `/images/${folderName}/carritos1.jpeg`;
	if (slug === 'juegos-mecanicos') return `/images/${folderName}/toro1.jpg`;
	if (slug === 'juegos-inflables') return `/images/${folderName}/inflable1.jpeg`;
	if (slug === 'juegos-de-salon') return `/images/${folderName}/arcade1.jpeg`;
	if (slug === 'juegos-stand') return `/images/${folderName}/stand1.jpeg`;
	if (slug === 'shows') return `/images/${folderName}/produccion1.jpeg`;
	if (slug === 'recuerdos-foto-video') return `/images/${folderName}/totem1.jpeg`;
	return null;
}

const servicesWithImages = services.map(service => ({
	...service,
	image: service.image || getFirstServiceImage(service.slug) || null
}));

const row1 = servicesWithImages.slice(0, 4);
const row2 = servicesWithImages.slice(4);
---

<section id="servicios" class="s-services">
	<div class="s-services__inner">
		<header class="s-services__header">
			<span class="s-services__label">Qué ofrecemos</span>
			<h2 class="s-services__title">Nuestros Servicios</h2>
			<p class="s-services__subtitle">Múltiples servicios para tu evento</p>
		</header>

		<div class="s-services__grid">
			<div class="s-services__row">
				{row1.map((service) => (
					<article class="s-card">
						<a href={`/servicios/${service.slug}`} class="s-card__link">
							<div class="s-card__media">
								{service.image ? (
									<img
										src={service.image}
										alt={service.title}
										loading="lazy"
										onerror="this.style.display='none'; this.nextElementSibling?.classList.add('is-visible');"
									/>
								) : null}
								<div class={`s-card__placeholder ${!service.image ? 'is-visible' : ''}`}>
									{service.icon}
								</div>
							</div>
							<div class="s-card__body">
								<h3 class="s-card__title">{service.title}</h3>
								<p class="s-card__text">{service.shortDescription}</p>
								<span class="s-card__cta">
									Más detalles
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</span>
							</div>
						</a>
						<a href="#contacto" class="s-card__contact">Solicitar información</a>
					</article>
				))}
			</div>
			<div class="s-services__row s-services__row--last">
				{row2.map((service) => (
					<article class="s-card">
						<a href={`/servicios/${service.slug}`} class="s-card__link">
							<div class="s-card__media">
								{service.image ? (
									<img
										src={service.image}
										alt={service.title}
										loading="lazy"
										onerror="this.style.display='none'; this.nextElementSibling?.classList.add('is-visible');"
									/>
								) : null}
								<div class={`s-card__placeholder ${!service.image ? 'is-visible' : ''}`}>
									{service.icon}
								</div>
							</div>
							<div class="s-card__body">
								<h3 class="s-card__title">{service.title}</h3>
								<p class="s-card__text">{service.shortDescription}</p>
								<span class="s-card__cta">
									Más detalles
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</span>
							</div>
						</a>
						<a href="#contacto" class="s-card__contact">Solicitar información</a>
					</article>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.s-services {
		--s-gap: 1.25rem;
		--s-card-radius: 20px;
		--s-card-max: 280px;
		padding: clamp(3rem, 8vw, 5rem) 0;
		background: var(--color-dark);
		position: relative;
		overflow: hidden;
	}

	.s-services::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 100% 60% at 50% 0%, rgba(107, 70, 193, 0.15) 0%, transparent 50%),
			radial-gradient(ellipse 80% 40% at 100% 100%, rgba(147, 51, 234, 0.08) 0%, transparent 50%);
		pointer-events: none;
	}

	.s-services__inner {
		position: relative;
		z-index: 1;
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 2rem);
	}

	.s-services__header {
		text-align: center;
		margin-bottom: clamp(2rem, 5vw, 3rem);
	}

	.s-services__label {
		display: inline-block;
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--color-accent);
		margin-bottom: 0.5rem;
	}

	.s-services__title {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 600;
		color: #fff;
		line-height: 1.2;
		margin: 0 0 0.5rem;
		letter-spacing: 0.02em;
	}

	.s-services__subtitle {
		font-family: var(--font-body);
		font-size: clamp(1rem, 2vw, 1.125rem);
		color: rgba(255, 255, 255, 0.7);
		margin: 0;
	}

	.s-services__grid {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--s-gap);
	}

	.s-services__row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--s-gap);
		width: 100%;
	}

	.s-services__row--last {
		justify-content: center;
	}

	/* Card */
	.s-card {
		width: 100%;
		max-width: var(--s-card-max);
		flex: 0 0 auto;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: var(--s-card-radius);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
	}

	.s-card:hover {
		transform: translateY(-8px);
		border-color: rgba(212, 175, 55, 0.25);
		box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(212, 175, 55, 0.08);
	}

	.s-card__link {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 0;
	}

	.s-card__media {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: rgba(0, 0, 0, 0.3);
	}

	.s-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.s-card:hover .s-card__media img {
		transform: scale(1.08);
	}

	.s-card__placeholder {
		position: absolute;
		inset: 0;
		display: none;
		align-items: center;
		justify-content: center;
		font-size: 3rem;
		color: rgba(255, 255, 255, 0.35);
	}

	.s-card__placeholder.is-visible {
		display: flex !important;
	}

	.s-card__body {
		padding: 1.25rem 1.25rem 1rem;
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 0;
	}

	.s-card__title {
		font-family: var(--font-heading);
		font-size: 1.25rem;
		font-weight: 600;
		color: #fff;
		line-height: 1.3;
		margin: 0 0 0.5rem;
		letter-spacing: 0.01em;
	}

	.s-card__text {
		font-family: var(--font-body);
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.72);
		line-height: 1.55;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
	}

	.s-card__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-accent);
		transition: gap 0.2s ease, color 0.2s ease;
	}

	.s-card__link:hover .s-card__cta {
		gap: 0.75rem;
		color: #e8c547;
	}

	.s-card__cta svg {
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.s-card__link:hover .s-card__cta svg {
		transform: translateX(4px);
	}

	.s-card__contact {
		display: block;
		text-align: center;
		padding: 0.75rem 1rem;
		margin: 0 1.25rem 1.25rem;
		font-family: var(--font-body);
		font-size: 0.8125rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		background: rgba(255, 255, 255, 0.06);
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}

	.s-card__contact:hover {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(212, 175, 55, 0.2);
		color: #fff;
	}

	/* Responsive: 1 col móvil */
	@media (max-width: 479px) {
		.s-services {
			--s-gap: 1rem;
			--s-card-max: 100%;
		}

		.s-card {
			max-width: 320px;
			margin: 0 auto;
		}
	}

	/* 2 columnas */
	@media (min-width: 480px) and (max-width: 767px) {
		.s-services {
			--s-card-max: calc(50% - var(--s-gap) / 2);
		}

		.s-card {
			flex: 0 0 calc(50% - var(--s-gap) / 2);
			max-width: 320px;
		}
	}

	/* 3 columnas */
	@media (min-width: 768px) and (max-width: 1023px) {
		.s-services {
			--s-card-max: calc((100% - var(--s-gap) * 2) / 3);
		}

		.s-card {
			flex: 0 0 calc((100% - var(--s-gap) * 2) / 3);
			max-width: 280px;
		}
	}

	/* 4 columnas: fila 1 con 4, fila 2 con 3 centradas */
	@media (min-width: 1024px) {
		.s-services__row {
			max-width: 1200px;
			margin: 0 auto;
		}

		.s-card {
			width: 280px;
			max-width: 280px;
			flex: 0 0 280px;
		}
	}
</style>
